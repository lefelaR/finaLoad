# Copy to .env and fill in. Never expose these to the Next.js client.
# Leave blank to run the labeled demo feed.

OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=
# practice | live
OANDA_ENV=practice

TWELVE_DATA_API_KEY=
MARKETAUX_API_KEY=
FXNEWSBIAS_API_KEY=

# Optional FinBERT / LLM scorer. POST {headline, text} -> {eur_score, usd_score}
SENTIMENT_API_URL=

# Optional delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional persistence. The app runs in memory if these are down.
DATABASE_URL=postgresql://trendlens:trendlens@localhost:5432/trendlens
REDIS_URL=redis://localhost:6379/0

# Set true to require the local JWT login.
AUTH_REQUIRED=false
JWT_SECRET=change-me
DEMO_USER=sipho
DEMO_PASSWORD=demo
